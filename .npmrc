save-exact=true
engine-strict=true
# Block packages published less than 7 days ago (npm >= 11.10; Node 24.15 bundles npm 11.12).
# Most malicious releases are unpublished within days. Dependabot's security PRs hit this too:
# that is deliberate, bump by hand with --min-release-age=0 only for a severe, reachable advisory.
min-release-age=7
